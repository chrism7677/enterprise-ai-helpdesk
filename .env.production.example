# Copy this file to .env.production on the production host, replace all
# placeholders, and restrict it with: chmod 600 .env.production

# PostgreSQL. URL-encode any reserved characters used in the password when
# constructing DATABASE_URL. The hostname must remain the Compose service: db.
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password
DATABASE_URL=postgresql+psycopg://helpdesk_user:replace_with_a_url_encoded_database_password@db:5432/helpdesk

# FastAPI Microsoft Entra access-token validation (identifiers, not secrets).
ENTRA_TENANT_ID=replace_with_entra_tenant_id
ENTRA_API_CLIENT_ID=replace_with_fastapi_api_client_id
ENTRA_REQUIRED_SCOPE=access_as_user

# Browser-visible Vite build configuration. Never place confidential values in
# a VITE_* variable.
VITE_API_BASE_URL=/api
VITE_ENTRA_CLIENT_ID=replace_with_spa_client_id
VITE_ENTRA_TENANT_ID=replace_with_entra_tenant_id
VITE_ENTRA_API_SCOPE=api://replace_with_fastapi_api_client_id/access_as_user

# Optional browser-visible portfolio demo identities. Leave these empty in
# ordinary local builds. Stage C supplies disposable public demo credentials.
VITE_DEMO_EMPLOYEE_USERNAME=
VITE_DEMO_EMPLOYEE_PASSWORD=
VITE_DEMO_IT_STAFF_USERNAME=
VITE_DEMO_IT_STAFF_PASSWORD=
