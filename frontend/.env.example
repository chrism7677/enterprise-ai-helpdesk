# Microsoft Entra ID SPA registration
VITE_ENTRA_CLIENT_ID=<your-react-app-client-id>
VITE_ENTRA_TENANT_ID=<your-entra-tenant-id>

# FastAPI delegated scope (used beginning in Auth-2B)
VITE_ENTRA_API_SCOPE=api://<your-fastapi-app-client-id>/access_as_user

# Base URL for the FastAPI backend. Prefer no trailing slash.
# Local development:
VITE_API_BASE_URL=http://localhost:8000

