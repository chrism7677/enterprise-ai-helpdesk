FROM node:24-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts index.html ./
COPY public ./public
COPY src ./src

ARG VITE_API_BASE_URL=/api
ARG VITE_ENTRA_CLIENT_ID
ARG VITE_ENTRA_TENANT_ID
ARG VITE_ENTRA_API_SCOPE
ARG VITE_DEMO_EMPLOYEE_USERNAME
ARG VITE_DEMO_EMPLOYEE_PASSWORD
ARG VITE_DEMO_IT_STAFF_USERNAME
ARG VITE_DEMO_IT_STAFF_PASSWORD

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_ENTRA_CLIENT_ID=${VITE_ENTRA_CLIENT_ID} \
    VITE_ENTRA_TENANT_ID=${VITE_ENTRA_TENANT_ID} \
    VITE_ENTRA_API_SCOPE=${VITE_ENTRA_API_SCOPE} \
    VITE_DEMO_EMPLOYEE_USERNAME=${VITE_DEMO_EMPLOYEE_USERNAME} \
    VITE_DEMO_EMPLOYEE_PASSWORD=${VITE_DEMO_EMPLOYEE_PASSWORD} \
    VITE_DEMO_IT_STAFF_USERNAME=${VITE_DEMO_IT_STAFF_USERNAME} \
    VITE_DEMO_IT_STAFF_PASSWORD=${VITE_DEMO_IT_STAFF_PASSWORD}

RUN npm run build

FROM nginx:1.28-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
